from typing import Generic, ParamSpec

from cyndilib.callback import Callback as BaseCallback
from cyndilib.callback import _CallbackType

_P = ParamSpec("_P")

class Callback(BaseCallback, Generic[_P]):
    def set(self, cb: _CallbackType[_P]) -> None: ...
    def remove(self) -> None: ...
    def trigger_no_args_no_kwargs(self) -> None: ...
    def trigger_with_args(self, *args: _P.args, **kwargs: _P.kwargs) -> None: ...
    def trigger_with_kwargs(self, *args: _P.args, **kwargs: _P.kwargs) -> None: ...
    def trigger_with_args_and_kwargs(self, *args: _P.args, **kwargs: _P.kwargs) -> None: ...
